# Contoh konfigurasi PRODUKSI linygadai. Salin ke .env di server lalu isi nilai bertanda <ISI>.
# Jalankan `php artisan sistem:periksa` sesudahnya: semuanya harus OK.

APP_NAME=linygadai
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://<ISI-domain-anda>
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Makassar

# Kunci HMAC hash NIK/IMEI. Buat sekali, simpan cadangannya terpisah, JANGAN diganti setelah ada data.
# Perintah pembuat: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
PII_HASH_KEY=

# Keamanan tambahan. Mode uji coba HARUS false di produksi (spanduk + data fiktif).
LINYGADAI_MODE_UJI=false
# Owner dan Manager wajib mengaktifkan 2FA (TOTP) sebelum memakai panel.
LINYGADAI_2FA_WAJIB=true

# Cadangan harian (php artisan sistem:cadangan). Isi sandi kuat agar ZIP terenkripsi; salin hasilnya ke lokasi lain.
BACKUP_PASSWORD=
# Isi hanya bila mysqldump tidak ditemukan otomatis, mis. /usr/bin/mysqldump
MYSQLDUMP_PATH=

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Pengguna database KHUSUS aplikasi (bukan root), sandi kuat, hak terbatas pada database ini saja.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<ISI>
DB_USERNAME=<ISI>
DB_PASSWORD=<ISI>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Email SMTP: wajib untuk "lupa kata sandi". JANGAN pakai MAIL_MAILER=log di produksi.
MAIL_MAILER=smtp
MAIL_HOST=<ISI>
MAIL_PORT=587
MAIL_USERNAME=<ISI>
MAIL_PASSWORD=<ISI>
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=<ISI-alamat-pengirim>
MAIL_FROM_NAME="${APP_NAME}"

# Kontak kantor pusat untuk bagian Tentang Kami (isi HANYA data resmi), lalu: php artisan db:seed --class=BranchSeeder
PUSAT_ALAMAT=
PUSAT_TELEPON=
PUSAT_WHATSAPP=
PUSAT_EMAIL=
PUSAT_LAT=
PUSAT_LNG=
PUSAT_JAM=
